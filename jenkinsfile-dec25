pipeline {
    agent any

    tools {
        maven 'maven'
    }

    environment {
        DOCKER_IMAGE = "nimbuswiztech/petclinic:latest"
        PATH = "$PATH:/usr/share/maven/bin"
        ARTIFACTORY_URL = 'http://18.61.83.141:8081/artifactory/libs-release'
        ARTIFACTORY_REPO = 'libs-release'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/nimbuswiztech/Petclinic.git'
            }
        }

        stage('Build Application') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t $DOCKER_IMAGE .'
            }
        }

        stage('Docker Login & Push') {
            steps {
                withDockerRegistry(credentialsId: 'docker-nimbus', url: 'https://index.docker.io/v1/') {
                    sh 'docker push $DOCKER_IMAGE'
                }
            }
        }
        stage('Push to Artifactory') {
            steps {
                script {
                    def server = Artifactory.server('artifact-server')

                    def uploadSpec = """{
                    "files": [{
                        "pattern": "target/*.war",
                        "target": "${ARTIFACTORY_REPO}/"
                    }]
                    }"""

                    server.upload(uploadSpec)
                }
            }
        }
    }
}
